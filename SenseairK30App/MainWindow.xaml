<Window x:Class="SenseairK30App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Senseair K30 CO₂ Monitor" Height="480" Width="500"
        Closing="Window_Closing">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 포트 설정 -->
        <GroupBox Grid.Row="0" Header="시리얼 포트 설정" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="8">
                <Label Content="포트:" VerticalAlignment="Center"/>
                <ComboBox x:Name="CmbPort" Width="100" Margin="4,0"
                          VerticalAlignment="Center"/>
                <Button Content="새로고침" Click="BtnRefresh_Click"
                        Padding="8,4" Margin="4,0"/>
                <Button x:Name="BtnConnect" Content="연결"
                        Click="BtnConnect_Click"
                        Padding="8,4" Margin="4,0"
                        Background="#4CAF50" Foreground="White"
                        FontWeight="Bold"/>
            </StackPanel>
        </GroupBox>

        <!-- CO₂ 표시 -->
        <GroupBox Grid.Row="1" Header="측정값" Margin="0,0,0,10">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CO₂ 수치 -->
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <Label Content="CO₂" FontSize="14"
                           HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtCO2"
                               Text="---"
                               FontSize="56" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="#2196F3"/>
                    <Label Content="ppm" FontSize="14"
                           HorizontalAlignment="Center" Foreground="Gray"/>
                </StackPanel>

                <!-- 센서 상태 -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Label Content="센서 상태" FontSize="14"
                           HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtStatus"
                               Text="---"
                               FontSize="20" FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtStatusDetail"
                               Text="" FontSize="11"
                               Foreground="Gray" TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               MaxWidth="160" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- 로그 -->
        <GroupBox Grid.Row="2" Header="로그">
            <ListBox x:Name="LstLog"
                     FontFamily="Consolas" FontSize="11"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     BorderThickness="0"/>
        </GroupBox>

        <!-- 하단 상태바 -->
        <StatusBar Grid.Row="3" Margin="0,6,0,0">
            <StatusBarItem>
                <TextBlock x:Name="TxtConnectionStatus" Text="연결 안됨"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
